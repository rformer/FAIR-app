# F-012 T-15 (design §3.6): an instance's values, the post-build variables
# of its Flux Kustomizations (ConfigMap flux-system/fair-instance). Written
# at onboarding from the instance root's outputs (infra/instance;
# docs/operations/fleet.md has the mapping); none is a secret. This example
# is checked by internal/fleet's tests: every variable the release and the
# fleet use is here.
FAIR_INSTANCE=example
FAIR_DEPLOYMENT_MODE=saas
FAIR_REGION=us-gov-west-1
FAIR_CLUSTER_NAME=fair-example
FAIR_VPC_ID=vpc-0123456789abcdef0
FAIR_APISERVER_CIDR=10.40.0.0/16
FAIR_INGRESS_CIDR=10.40.0.0/16
FAIR_INGRESS_HOST=example.fair.example.gov
FAIR_PLATFORM_HOST=example.fair.example.gov
FAIR_DB_HOST=fair-example.c0abcdefghij.us-gov-west-1.rds.amazonaws.com
FAIR_AUDIT_STORE_BUCKET=fair-example-audit-store
FAIR_AUDIT_STORE_ENDPOINT=s3-fips.us-gov-west-1.amazonaws.com:443
FAIR_AUDIT_STORE_REGION=us-gov-west-1
FAIR_AUDIT_WORM_BUCKET=fair-example-audit-worm
FAIR_AUDIT_WORM_ENDPOINT=s3-fips.us-gov-west-1.amazonaws.com:443
FAIR_AUDIT_WORM_REGION=us-gov-west-1
FAIR_REPORT_STORE_BUCKET=fair-example-report-store
FAIR_REPORT_STORE_ENDPOINT=s3-fips.us-gov-west-1.amazonaws.com:443
FAIR_REPORT_STORE_REGION=us-gov-west-1
FAIR_ROLE_AUDIT=arn:aws-us-gov:iam::111122223333:role/fair-example-audit
FAIR_ROLE_RISK=arn:aws-us-gov:iam::111122223333:role/fair-example-risk
FAIR_ROLE_EXTERNAL_SECRETS=arn:aws-us-gov:iam::111122223333:role/fair-example-external-secrets
FAIR_ROLE_LOAD_BALANCER_CONTROLLER=arn:aws-us-gov:iam::111122223333:role/fair-example-load-balancer-controller
FAIR_ROLE_PRIVATECA_ISSUER=arn:aws-us-gov:iam::111122223333:role/fair-example-privateca-issuer
FAIR_GATEWAY_TARGET_GROUP_ARN=arn:aws-us-gov:elasticloadbalancing:us-gov-west-1:111122223333:targetgroup/fair-example-gateway/0123456789abcdef
FAIR_PRIVATE_CA_ARN=arn:aws-us-gov:acm-pca:us-gov-west-1:111122223333:certificate-authority/01234567-89ab-cdef-0123-456789abcdef
FAIR_RELEASE_IMAGES=ghcr.io/rformer/fair-*
FAIR_COLLECTOR_IMAGES=index.docker.io/otel/opentelemetry-collector-contrib*
FAIR_OPS_PROMETHEUS_URL=https://prometheus.ops.fair.internal/api/v1/write
FAIR_OPS_LOKI_URL=https://loki.ops.fair.internal/otlp
FAIR_OPS_TEMPO_ENDPOINT=tempo.ops.fair.internal:4317
FAIR_KSM_TARGET=kube-state-metrics.kube-system.svc:8080
FAIR_CERT_MANAGER_TARGET=cert-manager.cert-manager.svc:9402
