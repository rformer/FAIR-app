{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fair:risk:common:1",
  "title": "FAIR risk documents: shared definitions",
  "description": "F-003 design §3: estimates, pins and text limits shared by every document kind. The risk service's validator is the authority; these schemas describe the same shapes for integrators and are kept in step with it by a test.",
  "$defs": {
    "schema_version": { "const": 1 },
    "uuid": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
    "decimal": {
      "description": "A decimal number: a JSON number on input, or a string in JSON number syntax. Stored documents hold canonical decimal strings.",
      "anyOf": [
        { "type": "number" },
        { "type": "string", "maxLength": 64, "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]{1,3})?$" }
      ]
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "line": { "type": "string", "maxLength": 1000 },
    "text": { "type": "string", "maxLength": 10000 },
    "source": {
      "type": "object",
      "required": ["type", "ref"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["person", "document", "dataset", "integration"] },
        "ref": { "$ref": "#/$defs/line", "minLength": 1 },
        "note": { "$ref": "#/$defs/line" }
      }
    },
    "estimate": {
      "description": "A calibrated range with its confidence, rationale and sources (F-003-AC-05, AC-06).",
      "type": "object",
      "required": ["min", "ml", "max", "unit", "confidence", "rationale", "sources"],
      "additionalProperties": false,
      "properties": {
        "min": { "$ref": "#/$defs/decimal" },
        "ml": { "$ref": "#/$defs/decimal" },
        "max": { "$ref": "#/$defs/decimal" },
        "unit": { "enum": ["events_per_year", "probability", "currency", "percentile", "fraction"] },
        "confidence": { "$ref": "#/$defs/decimal" },
        "rationale": { "$ref": "#/$defs/text", "minLength": 1 },
        "sources": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/source" } }
      }
    },
    "estimate_events_per_year": { "$ref": "#/$defs/estimate", "properties": { "unit": { "const": "events_per_year" } } },
    "estimate_probability": { "$ref": "#/$defs/estimate", "properties": { "unit": { "const": "probability" } } },
    "estimate_currency": { "$ref": "#/$defs/estimate", "properties": { "unit": { "const": "currency" } } },
    "estimate_percentile": { "$ref": "#/$defs/estimate", "properties": { "unit": { "const": "percentile" } } },
    "estimate_fraction": { "$ref": "#/$defs/estimate", "properties": { "unit": { "const": "fraction" } } },
    "pin": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/uuid" }, "version": { "type": "integer", "minimum": 1 } }
    },
    "form_of_loss": { "enum": ["productivity", "response", "replacement", "fines_judgments", "competitive_advantage", "reputation"] },
    "loss_map": {
      "description": "A magnitude per Open FAIR form of loss (F-003-AC-04).",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/form_of_loss" },
      "additionalProperties": { "$ref": "#/$defs/estimate_currency" }
    },
    "effect": {
      "description": "A control's effect on one factor: the fraction by which a factor or form of loss is reduced, or the resistance strength provided (a percentile).",
      "type": "object",
      "required": ["factor", "estimate"],
      "additionalProperties": false,
      "properties": {
        "factor": { "enum": ["contact_frequency", "probability_of_action", "threat_capability", "resistance_strength",
          "loss.productivity", "loss.response", "loss.replacement", "loss.fines_judgments", "loss.competitive_advantage", "loss.reputation"] },
        "estimate": true
      },
      "if": { "properties": { "factor": { "const": "resistance_strength" } } },
      "then": { "properties": { "estimate": { "$ref": "#/$defs/estimate_percentile" } } },
      "else": { "properties": { "estimate": { "$ref": "#/$defs/estimate_fraction" } } }
    },
    "effects": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/effect" } }
  }
}
