{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fair-crosswalk-v1.schema.json",
  "title": "fair.crosswalk.v1",
  "description": "F-013: relationships between the requirements of two framework versions (POST /api/v1/frameworks/imports, kind crosswalk). docs/formats/fair-crosswalk-v1.md describes it; internal/framework's checks are the authority, and this schema is checked against them.",
  "type": "object",
  "required": ["format", "title", "label", "source", "target", "relationships"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "fair.crosswalk.v1" },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "publisher": { "type": "string", "maxLength": 300 },
    "label": { "type": "string", "minLength": 1, "maxLength": 100, "description": "The crosswalk's own version." },
    "source": { "$ref": "#/$defs/ref" },
    "target": { "$ref": "#/$defs/ref" },
    "relationships": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200000,
      "items": {
        "type": "object",
        "required": ["source", "target", "relationship"],
        "additionalProperties": false,
        "properties": {
          "source": { "$ref": "#/$defs/identifier" },
          "target": { "$ref": "#/$defs/identifier" },
          "relationship": { "enum": ["equal", "subset_of", "superset_of", "intersects"], "description": "NIST IR 8278: the source requirement is equal to, a subset of, a superset of, or intersects with the target." }
        }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:()-]{0,99}$" },
    "ref": {
      "type": "object",
      "required": ["family", "version"],
      "additionalProperties": false,
      "properties": {
        "family": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    }
  }
}
