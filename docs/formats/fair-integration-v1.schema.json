{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fair-integration-v1.schema.json",
  "title": "fair.integration.v1",
  "description": "F-011: a batch of records pushed to an integration (POST /api/v1/imports/{integration}/batches). docs/formats/fair-integration-v1.md describes it; internal/integration's typed validation is the authority, and this schema is checked against it.",
  "type": "object",
  "required": ["format", "records"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "fair.integration.v1" },
    "complete": { "type": "boolean", "description": "The batch holds every record of the source: linked records it does not hold are proposed for archiving." },
    "records": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/record" } }
  },
  "$defs": {
    "external_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "bu": { "type": "string", "minLength": 1, "maxLength": 64, "description": "A business unit's code or id, inside the integration's subtree." },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "text": { "type": "string", "maxLength": 10000 },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "decimal": {
      "description": "A non-negative decimal, as a string or a JSON number; stored canonical.",
      "oneOf": [{ "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" }, { "type": "number", "minimum": 0 }]
    },
    "range": {
      "type": "object",
      "required": ["min", "ml", "max"],
      "additionalProperties": false,
      "properties": {
        "min": { "$ref": "#/$defs/decimal" },
        "ml": { "$ref": "#/$defs/decimal" },
        "max": { "$ref": "#/$defs/decimal" },
        "confidence": { "$ref": "#/$defs/decimal" },
        "basis": { "type": "string", "maxLength": 1000 }
      }
    },
    "record": {
      "type": "object",
      "required": ["kind"],
      "properties": { "kind": { "enum": ["asset", "asset_group", "loss_event", "risk", "control_status"] } },
      "oneOf": [
        { "$ref": "#/$defs/asset" }, { "$ref": "#/$defs/asset_group" }, { "$ref": "#/$defs/loss_event" },
        { "$ref": "#/$defs/risk" }, { "$ref": "#/$defs/control_status" }
      ]
    },
    "asset": {
      "type": "object",
      "required": ["kind", "external_id", "bu", "name", "asset_type"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "asset" },
        "external_id": { "$ref": "#/$defs/external_id" },
        "bu": { "$ref": "#/$defs/bu" },
        "name": { "$ref": "#/$defs/name" },
        "asset_type": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/text" },
        "value": { "$ref": "#/$defs/range" }
      }
    },
    "asset_group": {
      "type": "object",
      "required": ["kind", "external_id", "bu", "name", "members"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "asset_group" },
        "external_id": { "$ref": "#/$defs/external_id" },
        "bu": { "$ref": "#/$defs/bu" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/text" },
        "members": { "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "#/$defs/external_id" } },
        "value": { "$ref": "#/$defs/range" }
      }
    },
    "loss_event": {
      "type": "object",
      "required": ["kind", "external_id", "bu", "occurred_on", "event_type"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "loss_event" },
        "external_id": { "$ref": "#/$defs/external_id" },
        "bu": { "$ref": "#/$defs/bu" },
        "occurred_on": { "$ref": "#/$defs/date" },
        "event_type": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 2000 },
        "amounts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "productivity": { "$ref": "#/$defs/decimal" }, "response": { "$ref": "#/$defs/decimal" },
            "replacement": { "$ref": "#/$defs/decimal" }, "fines_judgments": { "$ref": "#/$defs/decimal" },
            "competitive_advantage": { "$ref": "#/$defs/decimal" }, "reputation": { "$ref": "#/$defs/decimal" }
          }
        }
      }
    },
    "risk": {
      "type": "object",
      "required": ["kind", "external_id", "bu", "title"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "risk" },
        "external_id": { "$ref": "#/$defs/external_id" },
        "bu": { "$ref": "#/$defs/bu" },
        "title": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/text" },
        "owner": { "type": "string", "maxLength": 254, "description": "The owner's email address." },
        "category": { "type": "string", "maxLength": 100 }
      }
    },
    "control_status": {
      "type": "object",
      "required": ["kind", "external_id", "status", "assessed_on"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "control_status" },
        "external_id": { "$ref": "#/$defs/external_id" },
        "control": { "type": "string", "format": "uuid", "description": "The platform control, the first time the external ID is seen." },
        "status": { "enum": ["in_place", "partial", "planned", "not_in_place"] },
        "assessed_on": { "$ref": "#/$defs/date" },
        "note": { "type": "string", "maxLength": 1000 }
      }
    }
  }
}
