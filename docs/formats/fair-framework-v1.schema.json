{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fair-framework-v1.schema.json",
  "title": "fair.framework.v1",
  "description": "F-013: one version of a control framework that has no OSCAL publication (POST /api/v1/frameworks/imports, kind simple). docs/formats/fair-framework-v1.md describes it; internal/framework's checks are the authority, and this schema is checked against them.",
  "type": "object",
  "required": ["format", "family", "version", "requirements"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "fair.framework.v1" },
    "family": {
      "type": "object",
      "required": ["key", "title"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$", "description": "The framework's stable key across versions, e.g. iso-27001." },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "publisher": { "type": "string", "maxLength": 300 }
      }
    },
    "version": {
      "type": "object",
      "required": ["label", "title"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "published": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "required": ["identifier", "title"],
        "additionalProperties": false,
        "properties": {
          "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:()-]{0,99}$", "description": "Unique within the version." },
          "label": { "type": "string", "maxLength": 100 },
          "title": { "type": "string", "minLength": 1, "maxLength": 500 },
          "statement": { "type": "string", "maxLength": 20000, "description": "Omit where the text is not licensed for the platform." },
          "parent": { "type": "string", "description": "Another requirement's identifier in the same version." }
        }
      }
    }
  }
}
