# Shell scripts must keep LF endings or bash fails on Windows checkouts
# with core.autocrlf=true.
*.sh  text eol=lf

# Migrations are checksummed (SHA-256) by the migration runner; a CRLF
# checkout would change the checksum and the runner would refuse to run.
*.sql text eol=lf

# Pinned third-party content is verified by SHA-256 (third_party/*/MANIFEST.json);
# store and check out the exact bytes.
third_party/** -text

# Profile packages record the SHA-256 of their inputs (bindings, in-repo
# profiles) and are pinned by digest themselves (F-015 T-06); every checkout
# must have the same bytes.
bindings/** text eol=lf
profiles/** text eol=lf
