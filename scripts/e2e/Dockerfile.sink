# Test image for scripts/k8s-e2e-scanner.sh: the scanner-sink stand-in for
# posture's scanner channel (F-015 T-27). Never shipped.
FROM golang:1.24-bookworm AS build
WORKDIR /src
ENV CGO_ENABLED=0 GOFIPS140=v1.0.0 GOFLAGS=-trimpath
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -o /out/scanner-sink ./scripts/e2e/scanner-sink

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/scanner-sink /scanner-sink
USER 65532:65532
ENTRYPOINT ["/scanner-sink"]
