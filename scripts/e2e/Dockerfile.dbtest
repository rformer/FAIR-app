# The database and UI-harness test container (fair-dbtest): Go with the
# PostgreSQL client. scripts/ui-e2e.sh and the README's Docker test runs use
# it; CI builds it from here (F-012 T-02).
FROM golang:1.27.4-bookworm@sha256:4fa7c968ba93f1635670522dbb01a2c78150443e1385746924566079f36570ea
RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends postgresql-client \
 && rm -rf /var/lib/apt/lists/*
